# Example values for the local PostgreSQL container in docker-compose.yml.
# Optional: copy to ".env" in the repository root to override the defaults.
# Local development only. Use your own password for anything else.
POSTGRES_USER=brokenvault
POSTGRES_PASSWORD=brokenvault
POSTGRES_DB=brokenvault

